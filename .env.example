# Bu dosyayı .env olarak kopyalayıp değerleri doldurun. .env dosyası repoya eklenmez.

# --- Veritabanı ---------------------------------------------------------
# DATABASE_URL tanımlıysa aşağıdaki DB_* değişkenleri yerine kullanılır.
# DATABASE_URL=postgresql://postgres:sifre@localhost:5432/urun_risk_analiz
DB_HOST=localhost
DB_PORT=5432
DB_NAME=urun_risk_analiz
DB_USER=postgres
DB_PASSWORD=

# --- Google Gemini ------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Embedding / Arama --------------------------------------------------
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
SEARCH_MIN_SIMILARITY=0.05

# --- API sunucusu -------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=5000
FLASK_DEBUG=false
CORS_ORIGINS=http://localhost:3000
